# komodo/komodo.env: instellingen van Komodo Core en Periphery.
# Gebaseerd op het officiële compose.env van Komodo v2.3.3. Alle opties:
#   https://github.com/moghtech/komodo/blob/main/config/core.config.toml
#   https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml
#
# De wachtwoorden hieronder zijn geen geheim: ze staan in een publieke repo. Dat kan alleen
# omdat Komodo enkel op je eigen laptop bereikbaar is (zie de poort in compose.yaml).

TZ=Europe/Brussels

#= Komodo Core =#

KOMODO_HOST=http://localhost:9120
KOMODO_TITLE=Komodo Bliep

# Inloggen met gebruikersnaam en wachtwoord. Bij de eerste start wordt deze admin gemaakt.
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=bliep-demo
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false

# De eerste server. komodo-resources.toml verwijst naar deze naam.
KOMODO_FIRST_SERVER_NAME=Local
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_WEBHOOK_SECRET=bliep-demo-webhook
KOMODO_JWT_SECRET=bliep-demo-jwt
KOMODO_JWT_TTL="1-day"

KOMODO_MONITORING_INTERVAL="15-sec"
KOMODO_RESOURCE_POLL_INTERVAL="5-min"

#= Komodo Periphery =#

PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=Local
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

# Geen shell in de agent of in de containers via de webinterface: voor de demo niet nodig.
PERIPHERY_DISABLE_TERMINALS=true
PERIPHERY_DISABLE_CONTAINER_TERMINALS=true

PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
